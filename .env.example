# Everything below is OPTIONAL. With no config, the app runs fully on a
# deterministic rule-based reasoner (LLM: rules in the UI).

# Turn on an LLM for root-cause narratives + dunning messages.
# provider: none | anthropic | openai | gemini
LLM_PROVIDER=none

# Set the key matching your provider:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# Optional model override (sensible defaults per provider otherwise):
# LLM_MODEL=claude-3-5-haiku-latest

# Simulation tuning (optional):
# TICK_SECONDS=0.6
# TXNS_PER_TICK=45
# PORT=8000
